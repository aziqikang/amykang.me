{
  // The Cabo game server: one Durable Object per room, reached over a
  // WebSocket at /room/<word>. Deploy with `npm run deploy` from this folder.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabo-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the kind available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
